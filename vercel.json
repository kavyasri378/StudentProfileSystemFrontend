{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "cleanUrls": {
    "production": "/",
    "development": "/"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "methods": ["GET", "POST", "PUT", "DELETE"]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "spmbackend.onrender.com"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "x-action"
        }
      ]
    }
  ]
}
